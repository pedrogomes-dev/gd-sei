{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GD-SEI: Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "django": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
